+/** Resolve one staged JA/KR cue. The manifest's upstream CN URL is never a source or fallback. */
+export function resolveVoiceCue(availability, selectedLanguage, charId, slot, lineIndex = 0) {
+  if (selectedLanguage !== 'ko' && selectedLanguage !== 'ja') return null;
+  if (typeof charId !== 'string' || !/^[A-Za-z0-9_-]+$/.test(charId) || typeof slot !== 'string') return null;
+  if (!Number.isInteger(lineIndex) || lineIndex < 0) return null;
+  const line = availability?.characters?.[charId]?.[slot]?.find((item) => item?.index === lineIndex);
+  if (!line || typeof line.cue !== 'string' || !/^[A-Za-z0-9_-]+\.mp3$/i.test(line.cue)) return null;
+  const candidate = (language, folder) => {
+    const entry = line[language];
+    const expectedUrl = `/assets/audio/voice/${folder}/${charId}/${line.cue}`;
+    const expectedAssetPath = expectedUrl.slice('/assets/'.length);
+    if (entry?.available !== true || entry.url !== expectedUrl || entry.assetPath !== expectedAssetPath) return null;
+    return entry;
+  };
+  const japanese = () => candidate('ja', 'jp');
+  if (selectedLanguage === 'ja') return japanese();
+  return candidate('kr', 'kr') || japanese();
+}
