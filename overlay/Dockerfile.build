# syntax=docker/dockerfile:1.7
# The final runtime stage depends on the exact pinned source archive, overlay, and asset manifest.
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

FROM ${NODE_IMAGE} AS verify
RUN apt-get update \
 && apt-get install -y --no-install-recommends git chromium \
 && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
WORKDIR /app
COPY --from=upstream /upstream.tar /tmp/upstream.tar
RUN tar -xf /tmp/upstream.tar -C /app && rm /tmp/upstream.tar
COPY --from=overlay / /overlay/
COPY --from=artifacts / /artifacts/
RUN test "$(tr -d '\r\n' < /artifacts/upstream-revision)" = "763e224b8d72c2362e70a8f1283a74e644195712"
RUN cp -a /app /upstream-pristine
RUN node /overlay/scripts/apply-overlay.mjs /app /overlay /artifacts
RUN node /overlay/scripts/overlay-version.mjs /app /overlay /artifacts
RUN npm ci --ignore-scripts --no-audit --no-fund && npm run vendor
ENV UPSTREAM=/upstream-pristine \
    ARTIFACTS=/artifacts \
    OVERLAY_APP_ROOT=/app
RUN npm test
RUN node --test \
    /overlay/tests/apply-overlay.test.mjs \
    /overlay/tests/overlay-contract.test.mjs \
    /overlay/tests/build-gates.test.mjs \
    /overlay/tests/i18n-browser.test.mjs
RUN mkdir -p /verify \
 && sha256sum data/local-assets.json public/fonts/nanum-gothic/*.ttf public/i18n/ko/*.json > /verify/artifact-hashes.txt

FROM ${NODE_IMAGE} AS production-deps
WORKDIR /app
COPY --from=upstream /upstream.tar /tmp/upstream.tar
RUN tar -xf /tmp/upstream.tar -C /app \
 && rm /tmp/upstream.tar \
 && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && npm cache clean --force

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
LABEL org.opencontainers.image.revision="763e224b8d72c2362e70a8f1283a74e644195712" \
      org.opencontainers.image.version="0.1.3-ko-overlay-v1" \
      org.opencontainers.image.title="Stronghold 0.1.3 Korean display overlay"
COPY --from=production-deps /app/package.json ./package.json
COPY --from=production-deps /app/node_modules ./node_modules
COPY --from=verify /app/shared ./shared
COPY --from=verify /app/server ./server
COPY --from=verify /app/data ./data
COPY --from=verify /app/public ./public
COPY --from=verify /app/docs/research ./docs/research
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","server/index.js"]
