# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

FROM ${NODE_IMAGE} AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY upstream.tar /tmp/upstream.tar
RUN tar -xf /tmp/upstream.tar -C /app && rm /tmp/upstream.tar
COPY overlay/ /overlay/
COPY artifacts/ /artifacts/
RUN test "$(tr -d '\r\n' < /artifacts/upstream-revision)" = "9f93096efaf4d1e671c76b8ca3efc4692b02d15b"
RUN node -e "if (require('./package.json').version !== '0.1.4') process.exit(1)"
RUN node -e "const lock = require('/overlay/overlay.lock.json'); if (!/^[a-f0-9]{64}$/.test(lock.assetManifest || '')) { console.error('final local-assets manifest SHA is pending; integrate Luna B output'); process.exit(1); }"
RUN test -s /artifacts/voice-availability.json
RUN node /overlay/scripts/apply-overlay.mjs /app /overlay /artifacts
RUN node /overlay/scripts/overlay-version.mjs /app /overlay /artifacts
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
RUN npm run vendor
RUN test -s /app/public/fonts/nanum-gothic/NanumGothic-Regular.ttf \
 && test -s /app/public/fonts/nanum-gothic/NanumGothic-Bold.ttf \
 && test -s /app/data/local-assets.json \
 && test -s /app/data/voice-availability.json

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
LABEL org.opencontainers.image.revision="9f93096efaf4d1e671c76b8ca3efc4692b02d15b" \
      org.opencontainers.image.version="0.1.4-ko-overlay-v2-voice-ja-kr" \
      org.opencontainers.image.title="Stronghold 0.1.4 Korean display and JA/KR voice overlay"
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/shared ./shared
COPY --from=build /app/server ./server
COPY --from=build /app/data ./data
COPY --from=build /app/public ./public
COPY --from=build /app/docs/research ./docs/research
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","server/index.js"]
